{
  "presets": [
    ["@babel/preset-env", { "modules": false }],
    ["@babel/preset-react", { "runtime": "automatic" }]
  ],
  "plugins": [["@babel/plugin-transform-runtime", { "corejs": 3 }]],
  "env": {
    "testing": {
      "presets": [
        ["@babel/preset-env", { "modules": "commonjs" }],
        ["@babel/preset-react", { "runtime": "automatic" }]
      ]
    }
  }
}
