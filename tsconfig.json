{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "es2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "*": ["./src/javascript/*"]
    },
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/javascript", "src/*.d.ts"]
}
